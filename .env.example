# Copy to .env.local and fill in values. Never commit real values.

# Supabase
# Supabase project URL (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (browser + server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: bypasses row-level security. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Stripe platform secret key. Server only.
STRIPE_SECRET_KEY=
# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect OAuth client id
NEXT_PUBLIC_STRIPE_OAUTH_CLIENT_ID=
# Signing secret for the platform webhook
STRIPE_WEBHOOK_SECRET_KEY=
# Signing secret for the Connect webhook
STRIPE_CONNECT_WEBHOOK_SECRET_KEY=

# Resend
# Resend email API key. Server only.
RESEND_API_KEY=
# Signing secret for the Resend email webhook
RESEND_WEBHOOK_SECRET=
# Signing secret for the Resend domain webhook
RESEND_DOMAIN_WEBHOOK_SECRET=

# Vercel (domain management)
# Vercel API token
AUTH_BEARER_TOKEN=
# Vercel project id
PROJECT_ID_VERCEL=
# Vercel team id
TEAM_ID_VERCEL=

# App
# Root domain for tenant subdomains
NEXT_PUBLIC_ROOT_DOMAIN=
# Absolute base URL for links
NEXT_PUBLIC_BASE_URL=
# Encrypts stored print-partner credentials. Do not change without re-encrypting stored data.
PLATFORM_ENCRYPTION_KEY=
